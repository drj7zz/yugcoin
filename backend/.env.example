MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Generate a unique value (for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ADMIN_EMAIL=your-admin-account@example.com
PORT=5000
# Optional: comma-separated browser origins allowed to call the API. Defaults to * for local development.
CORS_ORIGIN=http://localhost:3000
